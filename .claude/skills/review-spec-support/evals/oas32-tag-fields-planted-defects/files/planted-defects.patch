diff --git a/src/core/plugins/oas32/wrap-components/operation-tag.tsx b/src/core/plugins/oas32/wrap-components/operation-tag.tsx
new file mode 100644
index 00000000..a940e379
--- /dev/null
+++ b/src/core/plugins/oas32/wrap-components/operation-tag.tsx
@@ -0,0 +1,50 @@
+/**
+ * @prettier
+ */
+import React from "react"
+import ImPropTypes from "react-immutable-proptypes"
+
+/**
+ * Renders the OAS 3.2 Tag fields `kind` and `parent` next to the tag heading.
+ *
+ * Reference: https://spec.openapis.org/oas/v3.2.0.html#tag-object-fields
+ */
+const TAG_KINDS = ["nav", "badge", "audience"]
+
+const TagDetails = ({ tagObj }) => {
+  const tagDetails = tagObj.get("tagDetails")
+  const kind = tagDetails?.get("kind")
+  const parentName = tagDetails?.getIn(["parent", "name"])
+
+  return (
+    <>
+      {parentName && (
+        <span className="opblock-tag__parent">{parentName} /</span>
+      )}
+      {TAG_KINDS.includes(kind) && (
+        <span className={`opblock-tag__kind opblock-tag__kind--${kind}`}>
+          {kind}
+        </span>
+      )}
+    </>
+  )
+}
+
+TagDetails.propTypes = {
+  tagObj: ImPropTypes.map.isRequired,
+}
+
+const OperationTagWrapper = (Original, system) => (props) => {
+  if (!system.specSelectors.isOAS32()) {
+    return <Original {...props} />
+  }
+
+  return (
+    <div className="opblock-tag-oas32">
+      <TagDetails {...props} />
+      <Original {...props} />
+    </div>
+  )
+}
+
+export default OperationTagWrapper
diff --git a/test/e2e-playwright/features/oas32/oas32-tag-fields.spec.js b/test/e2e-playwright/features/oas32/oas32-tag-fields.spec.js
