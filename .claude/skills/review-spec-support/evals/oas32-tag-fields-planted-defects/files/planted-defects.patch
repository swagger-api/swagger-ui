index 00000000..c182c80c
--- /dev/null
+++ b/test/unit/core/plugins/oas32/tag-fields.test.ts
@@ -0,0 +1,26 @@
+/**
+ * @prettier
+ */
+import { fromJS } from "immutable"
+import { selectTagKinds } from "core/plugins/oas32/spec-extensions/selectors"
+
+describe("oas32 plugin - Tag fields", () => {
+  it("lists the distinct tag kinds used by the document", () => {
+    const system = {
+      specSelectors: {
+        specJson: () =>
+          fromJS({
+            openapi: "3.2.0",
+            tags: [
+              { name: "pets", kind: "nav" },
+              { name: "cats", kind: "nav", parent: "pets" },
+              { name: "internal", kind: "audience" },
+              { name: "store" },
+            ],
+          }),
+      },
+    }
+
+    expect(selectTagKinds()(system).toJS()).toEqual(["nav", "audience"])
+  })
+})
