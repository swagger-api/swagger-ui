+    summary: All about pets
+    description: Everything about your pets.
+    kind: nav
+  - name: cats
+    summary: Cats
+    parent: pets
+    kind: nav
+  - name: internal
+    summary: Internal operations
+    kind: audience
+  - name: partner
+    summary: Partner operations
+    kind: partner-api
+paths:
+  /pets:
+    get:
+      tags: [pets]
+      summary: List pets
+      responses:
