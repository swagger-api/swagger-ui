@@ -0,0 +1,17 @@
+/**
+ * @prettier
+ */
+import { test, expect } from "../../support/fixtures"
+
+test.describe("OAS 3.2 Tag fields", () => {
+  const baseUrl = "/?url=/documents/oas32/tag-fields.yaml"
+
+  test("renders tag summary, kind and parent", async ({ page }) => {
+    await page.goto(baseUrl)
+    await expect(page.locator("#operations-tag-pets")).toContainText(
+      "All about pets"
+    )
+    await expect(page.locator(".opblock-tag__kind--nav")).toBeAttached()
+    await expect(page.locator(".opblock-tag__parent")).toContainText("pets")
+  })
+})
